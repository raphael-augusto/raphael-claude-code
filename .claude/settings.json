{
  "mcpServers": {
    "docs-server": {
      "command": "python",
      "args": [".claude/mcp/docs_server.py"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/scripts/sync-global.sh\""
          }
        ]
      }
    ]
  }
}
